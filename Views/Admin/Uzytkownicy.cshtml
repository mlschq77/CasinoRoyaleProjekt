@model List<CasinoRoyale.Models.User>
@{
    ViewData["Title"] = "Uzytkownicy";
}

<div class="container py-5">
    <div class="d-flex align-items-center mb-2 gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i></a>
        <h1 class="mb-0 text-white">Uzytkownicy</h1>
        <span class="badge bg-secondary">@Model.Count</span>
    </div>

    @if (TempData["AdminMsg"] != null)
    {
        <div class="alert border-0 mt-3" style="background: rgba(40,167,69,0.15); color: #5cb85c;">
            <i class="fa-solid fa-check-circle me-2"></i>@TempData["AdminMsg"]
        </div>
    }

    <!-- Wyszukiwarka -->
    <form method="get" class="my-4 d-flex gap-2">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.1); color: #fff;" placeholder="Szukaj po emailu, nazwie, imieniu...">
        <button type="submit" class="btn casino-btn-primary px-4">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a asp-action="Uzytkownicy" class="btn btn-outline-secondary">Wyczysc</a>
        }
    </form>

    <div class="casino-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0" style="--bs-table-bg: transparent;">
                <thead style="background: rgba(0,0,0,.3);">
                    <tr class="text-secondary small">
                        <th class="px-4 py-3">ID</th>
                        <th class="py-3">Gracz</th>
                        <th class="py-3">E-mail</th>
                        <th class="py-3">Saldo</th>
                        <th class="py-3">Rejestracja</th>
                        <th class="py-3 text-center">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="px-4 text-secondary">@user.Id</td>
                            <td>
                                <div class="text-white fw-semibold">@user.Imie @user.Nazwisko</div>
                                <div class="text-secondary small">@@@user.Nazwa</div>
                            </td>
                            <td class="text-secondary">@user.Email</td>
                            <td>
                                <!-- Edycja salda inline -->
                                <form asp-action="EdytujSaldo" method="post" class="d-flex gap-1 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="number" name="newBalance" value="@((user.Wallet?.BalanceReal ?? 0).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                           step="0.01" min="0" class="form-control form-control-sm text-white"
                                           style="width:110px; background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.1);" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Zapisz saldo">
                                        <i class="fa-solid fa-check"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-secondary small">@user.DataRejestracji.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="text-center">
                                @if (user.Email.ToLower() != "admin@admin.pl")
                                {
                                    <form asp-action="UsunUzytkownika" method="post" onsubmit="return confirm('Na pewno usunac uzytkownika @user.Email?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Usun uzytkownika">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Admin</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
