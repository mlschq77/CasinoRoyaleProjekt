@model CasinoRoyale.ViewModels.AdminStatystykiViewModel
@{
    ViewData["Title"] = "Statystyki Gier";
}

<div class="container py-5">
    <div class="d-flex align-items-center mb-5 gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i></a>
        <h1 class="mb-0 text-white">Statystyki Gier</h1>
    </div>

    <!-- Podsumowanie -->
    <div class="row g-4 mb-5">
        <div class="col-sm-6">
            <div class="casino-card p-4 text-center">
                <i class="fa-solid fa-dice fa-2x text-gold mb-3"></i>
                <div class="fs-2 fw-bold text-white">@Model.LacznaLiczbaGier.ToString("N0")</div>
                <div class="text-secondary">Laczna liczba gier</div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="casino-card p-4 text-center">
                <i class="fa-solid fa-coins fa-2x text-gold mb-3"></i>
                <div class="fs-2 fw-bold text-white">@Model.LacznaSumaWplat.ToString("F2") PLN</div>
                <div class="text-secondary">Laczna suma zakladow</div>
            </div>
        </div>
    </div>

    <!-- Szczegoly per gra -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="casino-card p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <i class="fa-solid fa-playing-card fa-xl text-gold"></i>
                    <h5 class="text-white mb-0">Blackjack</h5>
                </div>
                <div class="mb-3">
                    <div class="text-secondary small mb-1">Liczba gier</div>
                    <div class="fs-4 fw-bold text-white">@Model.LiczbaBlackjack.ToString("N0")</div>
                </div>
                <div>
                    <div class="text-secondary small mb-1">Suma zakladow</div>
                    <div class="fs-4 fw-bold text-gold">@Model.SumaWplatBlackjack.ToString("F2") PLN</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="casino-card p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <i class="fa-solid fa-bomb fa-xl text-gold"></i>
                    <h5 class="text-white mb-0">Mines</h5>
                </div>
                <div class="mb-3">
                    <div class="text-secondary small mb-1">Liczba gier</div>
                    <div class="fs-4 fw-bold text-white">@Model.LiczbaMines.ToString("N0")</div>
                </div>
                <div>
                    <div class="text-secondary small mb-1">Suma zakladow</div>
                    <div class="fs-4 fw-bold text-gold">@Model.SumaWplatMines.ToString("F2") PLN</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="casino-card p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <i class="fa-solid fa-circle-dot fa-xl text-gold"></i>
                    <h5 class="text-white mb-0">Plinko</h5>
                </div>
                <div class="mb-3">
                    <div class="text-secondary small mb-1">Liczba gier</div>
                    <div class="fs-4 fw-bold text-white">@Model.LiczbaPlinko.ToString("N0")</div>
                </div>
                <div>
                    <div class="text-secondary small mb-1">Suma zakladow</div>
                    <div class="fs-4 fw-bold text-gold">@Model.SumaWplatPlinko.ToString("F2") PLN</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="casino-card p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <i class="fa-solid fa-dice fa-xl text-gold"></i>
                    <h5 class="text-white mb-0">Dice</h5>
                </div>
                <div class="mb-3">
                    <div class="text-secondary small mb-1">Liczba gier</div>
                    <div class="fs-4 fw-bold text-white">@Model.LiczbaDice.ToString("N0")</div>
                </div>
                <div>
                    <div class="text-secondary small mb-1">Suma zakladow</div>
                    <div class="fs-4 fw-bold text-gold">@Model.SumaWplatDice.ToString("F2") PLN</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="casino-card p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <i class="fa-solid fa-table-cells fa-xl text-gold"></i>
                    <h5 class="text-white mb-0">Keno</h5>
                </div>
                <div class="mb-3">
                    <div class="text-secondary small mb-1">Liczba gier</div>
                    <div class="fs-4 fw-bold text-white">@Model.LiczbaKeno.ToString("N0")</div>
                </div>
                <div>
                    <div class="text-secondary small mb-1">Suma zakladow</div>
                    <div class="fs-4 fw-bold text-gold">@Model.SumaWplatKeno.ToString("F2") PLN</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="casino-card p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <i class="fa-solid fa-clover fa-xl text-gold"></i>
                    <h5 class="text-white mb-0">Owocowy Slot</h5>
                </div>
                <div class="mb-3">
                    <div class="text-secondary small mb-1">Liczba gier</div>
                    <div class="fs-4 fw-bold text-white">@Model.LiczbaSlot.ToString("N0")</div>
                </div>
                <div>
                    <div class="text-secondary small mb-1">Suma zakladow</div>
                    <div class="fs-4 fw-bold text-gold">@Model.SumaWplatSlot.ToString("F2") PLN</div>
                </div>
            </div>
        </div>
    </div>
</div>
