@model CasinoRoyale.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Panel Admina";
}

<div class="container py-5">
    <div class="d-flex align-items-center mb-4 gap-3">
        <i class="fa-solid fa-shield-halved text-gold fa-2x"></i>
        <h1 class="mb-0 text-white">Panel Admina</h1>
    </div>

    @if (TempData["AdminMsg"] != null)
    {
        <div class="alert alert-success border-0 mb-4" style="background: rgba(40,167,69,0.15); color: #5cb85c;">
            <i class="fa-solid fa-check-circle me-2"></i>@TempData["AdminMsg"]
        </div>
    }

    <!-- Statystyki glowne -->
    <div class="row g-4 mb-5">
        <div class="col-sm-6 col-xl-3">
            <div class="casino-card p-4 text-center">
                <i class="fa-solid fa-users fa-2x text-gold mb-3"></i>
                <div class="fs-2 fw-bold text-white">@Model.TotalUsers</div>
                <div class="text-secondary">Uzytkownicy</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="casino-card p-4 text-center">
                <i class="fa-solid fa-coins fa-2x text-gold mb-3"></i>
                <div class="fs-2 fw-bold text-white">@Model.TotalBalance.ToString("F2") PLN</div>
                <div class="text-secondary">Laczne saldo graczy</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="casino-card p-4 text-center">
                <i class="fa-solid fa-arrow-down fa-2x text-gold mb-3"></i>
                <div class="fs-2 fw-bold text-white">@Model.TotalDeposits.ToString("F2") PLN</div>
                <div class="text-secondary">Wplaty ogolnie</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="casino-card p-4 text-center">
                <i class="fa-solid fa-tag fa-2x text-gold mb-3"></i>
                <div class="fs-2 fw-bold text-white">@Model.ActiveBonusCodes</div>
                <div class="text-secondary">Aktywne kody bonusowe</div>
            </div>
        </div>
    </div>

    <!-- Szybkie linki -->
    <div class="row g-3 mb-5">
        <div class="col-sm-4">
            <div class="casino-btn-wrap">
                <a asp-action="Uzytkownicy" class="casino-card p-4 d-flex align-items-center gap-3 text-decoration-none" style="transition: opacity .2s;" onmouseover="this.style.opacity='.8'" onmouseout="this.style.opacity='1'">
                    <i class="fa-solid fa-users fa-lg text-gold"></i>
                    <span class="text-white fw-semibold">Zarzadzaj uzytkownikami</span>
                </a>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="casino-btn-wrap">
                <a asp-action="KodyBonusowe" class="casino-card p-4 d-flex align-items-center gap-3 text-decoration-none" style="transition: opacity .2s;" onmouseover="this.style.opacity='.8'" onmouseout="this.style.opacity='1'">
                    <i class="fa-solid fa-tags fa-lg text-gold"></i>
                    <span class="text-white fw-semibold">Kody bonusowe</span>
                </a>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="casino-btn-wrap">
                <a asp-action="Statystyki" class="casino-card p-4 d-flex align-items-center gap-3 text-decoration-none" style="transition: opacity .2s;" onmouseover="this.style.opacity='.8'" onmouseout="this.style.opacity='1'">
                    <i class="fa-solid fa-chart-bar fa-lg text-gold"></i>
                    <span class="text-white fw-semibold">Statystyki gier</span>
                </a>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="casino-btn-wrap">
                <a asp-action="Kyc" class="casino-card p-4 d-flex align-items-center gap-3 text-decoration-none" style="transition: opacity .2s;" onmouseover="this.style.opacity='.8'" onmouseout="this.style.opacity='1'">
                    <i class="fa-solid fa-id-card fa-lg text-gold"></i>
                    <span class="text-white fw-semibold">Weryfikacja KYC</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Ostatnio zarejestrowani -->
    <div class="casino-card p-4">
        <h5 class="text-white mb-4"><i class="fa-solid fa-clock me-2 text-gold"></i>Ostatnio zarejestrowani</h5>
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0" style="--bs-table-bg: transparent;">
                <thead>
                    <tr class="text-secondary small">
                        <th>Gracz</th>
                        <th>E-mail</th>
                        <th>Saldo</th>
                        <th>Data rejestracji</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.RecentUsers)
                    {
                        <tr>
                            <td class="text-white">@user.Imie @user.Nazwisko <span class="text-secondary">(@user.Nazwa)</span></td>
                            <td class="text-secondary">@user.Email</td>
                            <td class="text-gold">@((user.Wallet?.BalanceReal ?? 0).ToString("F2")) PLN</td>
                            <td class="text-secondary">@user.DataRejestracji.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
                <a asp-action="Uzytkownicy" class="btn casino-btn-primary btn-sm">
                    <i class="fa-solid fa-list me-1"></i>Wszyscy uzytkownicy
                </a>
            </div>
        </div>
    </div>
