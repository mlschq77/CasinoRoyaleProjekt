@using System.Security.Claims

@{
    ViewData["Title"] = "Strona główna";
}

<div class="casino-home">
    <section class="casino-hero">
        <div class="container py-5">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="casino-eyebrow">Platforma premium dla graczy online</span>
                    <h1 class="display-3 fw-bold text-white mt-3">Graj odważnie. Wygrywaj po królewsku.</h1>
                    <p class="lead casino-hero-text mt-4">
                        Odkrywaj ekskluzywne stoły, automaty premium i rozgrywkę zaprojektowaną z myślą o szybkości, bezpieczeństwie oraz uczciwych zasadach.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
                        <a class="btn casino-btn-primary btn-lg" asp-controller="Home" asp-action="Oferta">Przejdź do katalogu gier</a>
                        <a href="#kyc" class="btn btn-outline-light btn-lg casino-btn-secondary">Poznaj proces KYC</a>
