@{
    ViewData["Title"] = "Mines";
}

<div class="container mt-5">

    <div class="casino-highlight-card p-4 text-center">

        <h2 class="text-gold mb-4">💣 Mines</h2>

        <div class="row justify-content-center mb-3">
            <div class="col-md-2">
                <input id="bet" type="number" value="100" class="casino-input" placeholder="Bet" />
            </div>
            <div class="col-md-2">
                <input id="mines" type="number" value="3" class="casino-input" placeholder="Mines" />
            </div>
        </div>

        <div class="mb-3">
            <button class="casino-btn-primary btn me-2" onclick="startGame()">Start</button>
            <button class="casino-btn-secondary btn" onclick="cashout()">Cashout</button>
        </div>

        <div id="grid" class="grid mt-4"></div>

        <p id="status" class="mt-3"></p>

    </div>

</div>
@section Scripts {
    <script src="~/js/mines.js"></script>
}




