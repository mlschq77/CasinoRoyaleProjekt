@{
    ViewData["Title"] = "Provably Fair";
}

<div class="casino-home">
    <section class="casino-section py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <span class="casino-section-label">
                        <i class="fa-solid fa-shield-halved"></i>Provably Fair
                    </span>
                    <h1 class="display-5 fw-bold text-white mt-3 mb-3">Transparentna rozgrywka</h1>
                    <p class="casino-section-text lead">
                        Ta sekcja opisuje podstawowy pomysl weryfikacji wynikow gier. Gracz powinien moc sprawdzic,
                        czy wynik rundy nie zostal zmieniony po rozpoczeciu rozgrywki.
                    </p>

                    <div class="row g-4 mt-2">
                        <div class="col-md-4">
                            <div class="casino-info-card h-100">
                                <i class="fa-solid fa-key text-gold fs-3 mb-3"></i>
                                <h2 class="h5 text-white">Seed gracza</h2>
                                <p class="casino-section-text mb-0">
                                    Losowy ciag ustawiany przez gracza przed rozpoczeciem rundy.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="casino-info-card h-100">
                                <i class="fa-solid fa-server text-gold fs-3 mb-3"></i>
                                <h2 class="h5 text-white">Seed serwera</h2>
                                <p class="casino-section-text mb-0">
                                    Wartosc generowana po stronie aplikacji i ujawniana po rundzie.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="casino-info-card h-100">
                                <i class="fa-solid fa-check-double text-gold fs-3 mb-3"></i>
                                <h2 class="h5 text-white">Weryfikacja</h2>
                                <p class="casino-section-text mb-0">
                                    Porownanie danych pozwala potwierdzic, ze wynik byl uczciwy.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="casino-info-card mt-4">
                        <h2 class="h4 text-white mb-3">Jak to sprawdzic?</h2>
                        <ul class="casino-check-list list-unstyled mb-0">
                            <li><i class="fa-solid fa-check text-gold me-2"></i>Zapisz seed rundy przed rozpoczeciem gry.</li>
                            <li><i class="fa-solid fa-check text-gold me-2"></i>Po rundzie porownaj go z danymi ujawnionymi przez serwer.</li>
                            <li><i class="fa-solid fa-check text-gold me-2"></i>Jesli wynik sie zgadza, runda byla mozliwa do zweryfikowania.</li>
                        </ul>
                    </div>

                    <a class="btn casino-btn-primary btn-lg mt-4" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-arrow-left me-2"></i>Powrot na strone glowna
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
