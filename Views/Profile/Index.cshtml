@model CasinoRoyale.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Profil gracza";
}

<div class="casino-home">
    <main class="casino-section py-5">
        <div class="container">
            <span class="casino-section-label">
                <i class="fa-solid fa-user"></i>Profil gracza
            </span>
            <h1 class="display-5 fw-bold text-white mt-3 mb-2">Twoje konto</h1>
            <p class="casino-section-text mb-0">
                Edytuj dane profilu i sprawdz historie aktywnosci konta.
            </p>

            @if (TempData["ProfileMessage"] is string message)
            {
                <div class="casino-profile-success mt-4">@message</div>
            }

            <div class="casino-profile-layout mt-4">
                <article class="casino-profile-card">
           
                    <div class="casino-profile-head">
                        <div class="casino-profile-avatar">@Model.Inicjaly</div>
                        <div>
                            <h2 class="casino-profile-name">@Model.PelneImie</h2>
            
                            <p class="casino-section-text mb-0">Aktywny gracz CasinoRoyale</p>
                        </div>
                    </div>

                    <form asp-action="Update" method="post" class="casino-profile-form mt-4">
            
                        @Html.AntiForgeryToken()

                        <div class="casino-profile-edit-grid">
                            <div>
                                <label class="casino-label" asp-for="Imie">Imie</label>
 
                                <input class="casino-input" asp-for="Imie" maxlength="80" placeholder="Twoje imie" />
                                <span asp-validation-for="Imie" class="casino-validation"></span>
                            </div>
                            <div>
                                <label class="casino-label" asp-for="Nazwisko">Nazwisko</label>
                    
                                <input class="casino-input" asp-for="Nazwisko" maxlength="120" placeholder="Twoje nazwisko" />
                                <span asp-validation-for="Nazwisko" class="casino-validation"></span>
                            </div>
                    
                            <div>
                                <label class="casino-label" asp-for="Nazwa">Nazwa gracza</label>
                                <input class="casino-input" asp-for="Nazwa" maxlength="80" placeholder="Twoja nazwa gracza" autocomplete="username" />
                 
                                <span asp-validation-for="Nazwa" class="casino-validation"></span>
                            </div>
                            <div>
                           
                                <label class="casino-label" asp-for="Email">Email</label>
                                <input class="casino-input" asp-for="Email" type="email" maxlength="160" placeholder="twoj@email.com" autocomplete="email" />
                                <span asp-validation-for="Email" class="casino-validation"></span>
                    
                            </div>
                        </div>

                        <button class="casino-btn-primary btn mt-4" type="submit">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Zapisz dane
                        </button>
                    </form>
                </article>

                <aside class="casino-profile-card">
                    <h2 class="h4 text-white mb-3">Podsumowanie</h2>
        
                    <div class="casino-profile-stat">
                        <span>Nazwa gracza</span>
                        <strong>@Model.Nazwa</strong>
                    </div>
                  
                    <div class="casino-profile-stat">
                        <span>Saldo rzeczywiste</span>
                        <strong>@Model.Balance.ToString("0.00") PLN</strong>
                    </div>
                    @if (Model.BalanceBonus > 0)
                    {
                        <div class="casino-profile-stat">
                            <span>Saldo bonusowe</span>
                            <strong class="text-warning">@Model.BalanceBonus.ToString("0.00") PLN</strong>
                        </div>
                    }
                    <div class="casino-profile-stat">
                        <span>Status konta</span>
                        <strong>Aktywne</strong>
                    </div>
                    <div class="casino-profile-stat">
                        <span>Status KYC</span>
                        <strong class="@Model.KycStatusCssClass">@Model.KycStatusDisplay</strong>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Kyc" asp-action="Index" class="btn casino-btn-primary btn-sm w-100">
                            <i class="fa-solid fa-id-card me-1"></i>KYC — dokumenty
                        </a>
                    </div>
                    <div class="casino-profile-stat">
                        <span>Data rejestracji</span>
                        <strong>@Model.DataRejestracji.ToLocalTime().ToString("dd.MM.yyyy")</strong>
                    </div>

                    <div class="casino-profile-actions">
                        @if (Model.BalanceBonus > 0)
                        {
                            <a asp-action="Bonuses" class="btn casino-btn-primary btn w-100">
                                <i class="fa-solid fa-gift me-1"></i>Bonusy i obrot
                            </a>
                        }
                        <button class="casino-btn-secondary btn" type="button" data-history-open="transactions">
                            <i class="fa-solid fa-receipt me-1"></i>Historia transakcji
                        </button>
                        <button class="casino-btn-secondary btn" type="button" data-history-open="bets">
                            <i class="fa-solid fa-coins me-1"></i>Historia zakladow
                        </button>
                        <button class="casino-btn-secondary btn" type="button" data-history-open="logins">
                            <i class="fa-solid fa-right-to-bracket me-1"></i>Historia logowan
                        </button>
                        
                        <a asp-action="DownloadHistoryPdf" class="casino-btn-secondary btn w-100 mt-2 d-flex align-items-center justify-content-center text-decoration-none">
                            <i class="fa-solid fa-file-pdf me-2"></i>Pobierz raport PDF
                        </a>
                    </div>
                </aside>
            </div>
        </div>
    </main>
</div>

<div class="casino-confirm-modal" id="kyc-confirm-modal" aria-hidden="true">
    <div class="casino-confirm-panel">
        <div class="casino-confirm-icon">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
      
        <h2 class="casino-confirm-title">Zmiana danych osobowych</h2>
        <p class="casino-confirm-text">
            Czy na pewno chcesz zmienić swoje dane osobowe?<br><br>
            <strong>Zmiana imienia lub nazwiska spowoduje zresetowanie statusu weryfikacji KYC</strong>
            i będzie wymagać ponownego przesłania dokumentów do zatwierdzenia przez administratora.
        </p>
        <div class="casino-confirm-actions">
            <button class="btn casino-btn-secondary" type="button" data-confirm-no>
                <i class="fa-solid fa-xmark me-1"></i>Anuluj
            </button>
            <button class="btn casino-btn-primary" type="button" data-confirm-yes>
                <i class="fa-solid fa-check me-1"></i>Tak, zmień dane
            </button>
        </div>
    </div>
</div>

<div class="casino-history-modal" id="transactions-modal" aria-hidden="true">
    <div class="casino-history-panel">
        <button class="casino-history-close" type="button" data-history-close>
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h2>Historia transakcji</h2>
        <div class="casino-history-list">
            @if (Model.TransactionHistory.Any())
            {
                foreach (var item in Model.TransactionHistory)
                {
                    <div class="casino-history-row">
                        <span>@item.Type</span>
                        <strong>@item.Amount.ToString("0.00") @item.Currency</strong>
                        <time>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                    </div>
                }
            }
            else
            {
                <div class="casino-history-empty">Brak transakcji.</div>
            }
        </div>
    </div>
</div>

<div class="casino-history-modal" id="bets-modal" aria-hidden="true">
    <div class="casino-history-panel">
        <button class="casino-history-close" type="button" data-history-close>
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h2>Historia zakladow</h2>                    <div class="casino-history-list">
                        @if (Model.BetHistory.Any())
                        {
                            foreach (var item in Model.BetHistory)
                            {
                                <div class="casino-history-row">
                                    <span>@item.GameName</span>
                                    <strong class="text-white">@item.BetAmount.ToString("0.00") PLN</strong>
                                    @if (item.PayoutAmount.HasValue)
                                    {
                                        var cssClass = item.PayoutAmount.Value > item.BetAmount ? "text-success" : (item.PayoutAmount.Value < item.BetAmount ? "text-secondary" : "text-gold-soft");
                                        <strong class="@cssClass">@item.PayoutAmount.Value.ToString("0.00") PLN</strong>
                                    }
                                    else
                                    {
                                        <strong class="text-secondary">w trakcie</strong>
                                    }
                                    <time>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="casino-history-empty">Brak zakladow.</div>
                        }
                    </div>
    </div>
</div>

<div class="casino-history-modal" id="logins-modal" aria-hidden="true">
    <div class="casino-history-panel">
        <button class="casino-history-close" type="button" data-history-close>
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h2>Historia logowan</h2>
        <div class="casino-history-list">
            @if (Model.LoginHistory.Any())
            {
                foreach (var item in Model.LoginHistory)
                {
                    <div class="casino-history-row">
                        <span>
                            @if (item.EventType == "login")
                            {
                                <i class="fa-solid fa-check-circle text-success me-1"></i>
                            }
                            else if (item.EventType == "failed_login")
                            {
                                <i class="fa-solid fa-xmark-circle text-danger me-1"></i>
                            }
                            else if (item.EventType == "logout")
                            {
                                <i class="fa-solid fa-arrow-right-from-bracket text-secondary me-1"></i>
                            }
                            @item.EventTypeDisplay
                        </span>
                        <span class="text-secondary small" title="IP: @item.IpAddress">
                            @item.IpAddress
                        </span>
                        <time title="@item.UserAgent">@item.LoggedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                    </div>
                }
            }
            else
            {
                <div class="casino-history-empty">Brak historii logowan.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.querySelectorAll('[data-history-open]').forEach(button => {
            button.addEventListener('click', () => {
                const modal = document.getElementById(button.dataset.historyOpen + '-modal');
                if (modal) modal.classList.add('is-open');
            });
        });

        document.querySelectorAll('[data-history-close], .casino-history-modal').forEach(element => {
            element.addEventListener('click', event => {
                if (event.target !== element && !element.hasAttribute('data-history-close')) return;
                document.querySelectorAll('.casino-history-modal').forEach(modal => modal.classList.remove('is-open'));
            });
        });

        (function() {
            const form = document.querySelector('.casino-profile-form');
            if (!form) return;

            const modal = document.getElementById('kyc-confirm-modal');
            const btnYes = modal ? modal.querySelector('[data-confirm-yes]') : null;
            const btnNo = modal ? modal.querySelector('[data-confirm-no]') : null;

            const imieInput = document.getElementById('Imie');
            const nazwiskoInput = document.getElementById('Nazwisko');

            const oryginalneImie = imieInput ? imieInput.value.trim() : '';
            const oryginalneNazwisko = nazwiskoInput ? nazwiskoInput.value.trim() : '';

            let pendingSubmit = null;

            form.addEventListener('submit', function (e) {
                const noweImie = imieInput ? imieInput.value.trim() : '';
                const noweNazwisko = nazwiskoInput ? nazwiskoInput.value.trim() : '';

                const imieSieZmienilo = noweImie !== oryginalneImie;
                const nazwiskoSieZmienilo = noweNazwisko !== oryginalneNazwisko;

                if ((imieSieZmienilo || nazwiskoSieZmienilo) && modal) {
                    e.preventDefault();
                    pendingSubmit = e.target;
                    modal.classList.add('is-open');
                    
                    const firstBtn = modal.querySelector('[data-confirm-no]');
                    if (firstBtn) firstBtn.focus();
                }
            });

            if (btnYes) {
                btnYes.addEventListener('click', function () {
                    modal.classList.remove('is-open');
                    if (pendingSubmit) {
                        pendingSubmit.submit();
                        pendingSubmit = null;
                    }
                });
            }

            if (btnNo) {
                btnNo.addEventListener('click', function () {
                    modal.classList.remove('is-open');
                    pendingSubmit = null;
                });
            }

            
            if (modal) {
                modal.addEventListener('click', function (e) {
                    if (e.target === modal) {
                        modal.classList.remove('is-open');
                        pendingSubmit = null;
                    }
                });
            }
        })();
    </script>
}