@{
    ViewData["Title"] = "Crash";
}

<link rel="stylesheet" href="~/css/crash.css" asp-append-version="true" />

<div class="crash-wrapper">
    <div class="crash-container">

        <div class="crash-header">
            <span class="casino-section-label">
                <i class="fa-solid fa-rocket me-2"></i>CasinoRoyale Originals
            </span>
            <h1 class="crash-title">Crash</h1>
            <p class="crash-subtitle">Wypłać zanim wybuchnie!</p>
        </div>

        <div class="crash-main">
            <div class="crash-display-area" id="crash-display-area">
                <div class="crash-canvas-wrap">
                    <canvas id="crash-chart" width="700" height="400"></canvas>
                    <div class="crash-multiplier-display" id="multiplierDisplay">1.00x</div>
                </div>
            </div>

            <div class="crash-controls">
                <div class="crash-bet-section">
                    <label class="casino-label" for="betAmount">Stawka</label>
                    <div class="casino-input-wrapper mb-3">
                        <i class="fa-solid fa-coins casino-input-icon"></i>
                        <input id="betAmount" type="number" min="1" step="1" value="100" class="casino-input" />
                    </div>
                </div>

                <div class="crash-auto-section">
                    <label class="casino-label" for="autoCashout">Auto wypłata (x)</label>
                    <div class="casino-input-wrapper mb-3">
                        <i class="fa-solid fa-gear casino-input-icon"></i>
                        <input id="autoCashout" type="number" min="1.01" step="0.01" value="2.00" class="casino-input" />
                    </div>
                </div>

                <div class="crash-buttons">
                    <button id="startBtn" class="btn casino-btn-primary w-100 mb-2" onclick="startGame()">
                        <i class="fa-solid fa-play me-2"></i>Graj
                    </button>
                    <button id="cashoutBtn" class="btn casino-btn-secondary w-100" onclick="cashout()" disabled>
                        <i class="fa-solid fa-hand me-2"></i>Wypłać
                    </button>
                </div>

                <div id="crash-result" class="crash-result" aria-live="polite">
                    <span id="crash-status">Gotowy do gry</span>
                    <strong id="crash-win"></strong>
                </div>
            </div>
        </div>

        <div class="crash-history">
            <h3 class="crash-history-title">Historia crashy</h3>
            <div id="crash-history-list" class="crash-history-list"></div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/games/crash.js" asp-append-version="true"></script>
}
