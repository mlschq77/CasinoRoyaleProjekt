@model CasinoRoyale.ViewModels.DepositViewModel

@{
    ViewData["Title"] = "Doladowanie";
}

<div class="container py-5">
    <div class="casino-highlight-card p-4 mx-auto" style="max-width: 560px;">
        <div class="text-center mb-4">
            <h1 class="h2 text-gold mb-2">Doladowanie balansu</h1>
            <p class="casino-section-text mb-0">Platnosc testowa Stripe Checkout.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-info">@Model.Message</div>
        }

        @if (!Model.StripeConfigured)
        {
            <div class="alert alert-warning">
                Brakuje klucza testowego Stripe. Ustaw konfiguracje <code>Stripe:SecretKey</code> na klucz zaczynajacy sie od <code>sk_test_</code>.
            </div>
        }

        <form asp-controller="Payments" asp-action="CreateCheckoutSession" method="post" class="d-grid gap-3">
            @Html.AntiForgeryToken()

            <div>
                <label asp-for="Amount" class="casino-label"></label>
                <input asp-for="Amount" id="amount" type="number" min="10" max="10000" step="1" class="casino-input" />
                <span asp-validation-for="Amount" class="casino-validation"></span>
            </div>

            <div>
                <label asp-for="KodBonusowy" class="casino-label"></label>
                <input asp-for="KodBonusowy" class="casino-input" maxlength="64" placeholder="Wpisz kod bonusowy" autocomplete="off" />
                <span asp-validation-for="KodBonusowy" class="casino-validation"></span>
                <span id="kodBonusowyLiveValidation" class="casino-validation"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-light casino-btn-secondary" onclick="document.getElementById('amount').value = 50">50</button>
                <button type="button" class="btn btn-outline-light casino-btn-secondary" onclick="document.getElementById('amount').value = 100">100</button>
                <button type="button" class="btn btn-outline-light casino-btn-secondary" onclick="document.getElementById('amount').value = 250">250</button>
            </div>

            <button type="submit" class="btn casino-btn-primary" disabled="@(!Model.StripeConfigured)">
                <i class="fa-solid fa-credit-card me-2"></i>Przejdz do Stripe
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        (() => {
            const codeInput = document.getElementById("KodBonusowy");
            const amountInput = document.getElementById("amount");
            const validationMessage = document.getElementById("kodBonusowyLiveValidation");
            const submitButton = document.querySelector("button[type='submit']");
            const stripeDisabled = submitButton?.disabled ?? false;
            const validationUrl = "@Url.Action("ValidateBonusCode", "Payments")";
            let validationTimer;

            const setSubmitDisabled = (disabled) => {
                if (submitButton) {
                    submitButton.disabled = stripeDisabled || disabled;
                }
            };

            const setMessage = (message, isValid) => {
                validationMessage.textContent = message;
                validationMessage.className = isValid
                    ? "casino-validation text-success"
                    : "casino-validation";
            };

            const validateBonusCode = async () => {
                const kodBonusowy = codeInput.value.trim();
                if (!kodBonusowy) {
                    setMessage("", true);
                    setSubmitDisabled(false);
                    return;
                }

                const params = new URLSearchParams({
                    kodBonusowy,
                    amount: amountInput.value || "0"
                });

                try {
                    const response = await fetch(`${validationUrl}?${params}`, {
                        headers: { "Accept": "application/json" }
                    });

                    if (!response.ok) {
                        setMessage("Nie mozna teraz sprawdzic kodu.", false);
                        setSubmitDisabled(true);
                        return;
                    }

                    const result = await response.json();
                    setMessage(result.message || "", result.isValid);
                    setSubmitDisabled(!result.isValid);
                } catch {
                    setMessage("Nie mozna teraz sprawdzic kodu.", false);
                    setSubmitDisabled(true);
                }
            };

            const scheduleValidation = () => {
                window.clearTimeout(validationTimer);
                validationTimer = window.setTimeout(validateBonusCode, 350);
            };

            codeInput?.addEventListener("input", scheduleValidation);
            amountInput?.addEventListener("input", scheduleValidation);
        })();
    </script>
}
